# 数据库配置
# 测试数据库（运行 cargo test 使用，与生产库隔离）
# DATABASE_URL_TEST=postgres://user:password@host:port/test

DATABASE_URL=postgresql://username:password@localhost:5432/blog_db

# JWT配置
# 生产环境请使用强随机密钥，至少32个字符
# Generate a new random secret with: openssl rand -hex 32
JWT_SECRET=

# 日志级别
# 可选值: error, warn, info, debug, trace
RUST_LOG=info

# 服务器配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# CORS配置
# 生产环境请配置具体的允许源，多个源用逗号分隔
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=*

# 七牛云存储配置 (可选)
# 如不使用七牛云，可以注释掉以下配置
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=your-bucket-name
QINIU_DOMAIN=your-cdn-domain.com

# 邮件服务配置 (可选)
# 用于发送验证邮件、通知等
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password

# 文件上传配置
# 最大文件大小 (字节)
MAX_FILE_SIZE=10485760  # 10MB
# 临时文件目录
TEMP_UPLOAD_DIR=./temp_uploads

# 会话配置
# JWT令牌过期时间 (秒)
JWT_EXPIRATION=86400  # 24小时

# 数据库连接池配置
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=10
DATABASE_IDLE_TIMEOUT=600
DATABASE_MAX_LIFETIME=1800

# 权限缓存配置
# 权限缓存过期时间 (秒)
PERM_CACHE_TTL=3600  # 1小时

# WebSocket配置
WS_HEARTBEAT_INTERVAL=5  # 心跳间隔 (秒)
WS_CLIENT_TIMEOUT=10     # 客户端超时 (秒)

# 环境标识
# 可选值: development, production
ENVIRONMENT=development

# 是否启用调试模式
DEBUG=true

# API文档配置
# 是否启用Swagger UI
ENABLE_SWAGGER=true

# 可选监测端口：不设置则关闭；只允许回环地址
# METRICS_BIND=127.0.0.1:9090
# 指标无需开启完整 SQL 日志
DATABASE_SQLX_LOGGING=false
DATABASE_TEST_BEFORE_ACQUIRE=true
# 日志诊断开关（默认均为true）
HTTP_ACCESS_LOG_ENABLED=true
CONNECTION_LOG_ENABLED=true
# 可覆盖文件轮转阈值；未设置时维持原值10240字节
# LOG_ROLL_BYTES=1048576

# 图片上传：默认保留七牛云；本地验收可显式选择 local
# IMAGE_STORAGE_PROVIDER=qiniu
# IMAGE_STORAGE_PROVIDER=local
# LOCAL_IMAGE_DIR=./data/images
# local 模式仅支持 PNG/JPG/WebP，单张10MB，转换WebP并限制尺寸。
# 使用 local 时必须持久化此目录；前端通过 /api/v1/images/file/ 读取。
